# Rendered by the nginx image's envsubst step: ${API_DOMAIN} / ${STORAGE_DOMAIN} come from deploy/.env.
# HTTP only. After issuing certificates, enable https.conf.template.example (see deploy/README.md).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

gzip on;
gzip_types application/json application/problem+json text/plain text/css application/javascript;
gzip_min_length 1024;
server_tokens off;

upstream nearby-app {
    server app:8080;
    keepalive 32;
}

# --- API: REST + WebSocket ---------------------------------------------------
server {
    listen 80;
    server_name ${API_DOMAIN} localhost;

    # JSON only; images go straight to object storage via presigned URLs
    client_max_body_size 1m;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location /ws {
        proxy_pass http://nearby-app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 1h;
    }

    # Only health is exposed publicly; metrics are scraped on the internal network
    location /actuator/health {
        proxy_pass http://nearby-app;
        proxy_set_header Host $host;
    }
    location /actuator {
        return 404;
    }

    location /grafana/ {
        proxy_pass http://grafana:3000;
        proxy_set_header Host $host;
    }

    location / {
        proxy_pass http://nearby-app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# --- Object storage (MinIO) for presigned URLs ---------------------------------
server {
    listen 80;
    server_name ${STORAGE_DOMAIN};

    # Listing images (max 8 per listing); keep in sync with the upload policy
    client_max_body_size 10m;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        proxy_pass http://minio:9000;
        # The Host header is part of the presigned signature: pass it through unchanged
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
    }
}
