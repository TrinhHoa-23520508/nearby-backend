# Copy to deploy/.env and fill in. Never commit the real .env.

APP_IMAGE=ghcr.io/<github-owner>/nearby-backend:latest

POSTGRES_DB=nearby
POSTGRES_USER=nearby
POSTGRES_PASSWORD=change-me

REDIS_PASSWORD=change-me

# openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
JWT_ISSUER=nearby-backend

MINIO_ROOT_USER=nearby
MINIO_ROOT_PASSWORD=change-me-min-8-chars
MINIO_BUCKET=nearby-images
# Public domains served by Nginx. Presigned URLs are signed for STORAGE_DOMAIN, so it must be a
# dedicated host (MinIO cannot sign URLs under a path prefix).
API_DOMAIN=api.example.com
STORAGE_DOMAIN=storage.example.com
MINIO_PUBLIC_ENDPOINT=https://storage.example.com

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
