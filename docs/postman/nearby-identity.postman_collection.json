              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Location consent",
      "description": "Consent to location data processing (FR-ID-06).",
      "item": [
        {
          "name": "Get location consent",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me/location-consent",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "me",
                "location-consent"
              ]
            },
            "description": "granted is true only for an active consent to currentTermsVersion.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
