              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Problem code is INVALID_IMAGE\", () => pm.expect(pm.response.json().code).to.eql(\"INVALID_IMAGE\"));"
                ]
              }
            }
          ]
        },
        {
