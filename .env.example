# Local development configuration. Copy to .env (gitignored) and adjust:
#   cp .env.example .env
# Read by Docker Compose (compose.yaml) and by Spring Boot (spring.config.import).
# Format: KEY=value, no quotes. Real environment variables override this file.
# Production uses deploy/.env.example instead.

# PostgreSQL + PostGIS container. Host port 5433 avoids a PostgreSQL installed on the machine (5432).
POSTGRES_DB=nearby
POSTGRES_USER=nearby
POSTGRES_PASSWORD=nearby
POSTGRES_PORT=5433
DB_POOL_SIZE=10

# Redis container
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT: HS256 secret of at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=local-dev-secret-change-me-please-32b+
JWT_ISSUER=nearby-backend
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# MinIO container
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
# Host the Android app uses for presigned image URLs (signatures are bound to this host):
#   emulator: http://10.0.2.2:9000   real phone on the same Wi-Fi: http://<LAN-IP>:9000
MINIO_PUBLIC_ENDPOINT=http://10.0.2.2:9000
MINIO_ACCESS_KEY=nearby
MINIO_SECRET_KEY=nearby-secret
MINIO_BUCKET=nearby-images
MINIO_REGION=us-east-1
MINIO_PRESIGN_TTL=10m

# Server
SERVER_PORT=8080
IDEMPOTENCY_TTL=24h
